[
  { "id": "01-titulo", "speaker": "pino", "text": "Las Tardes de Pino. Hoy: ¡Pino aprende los colores!", "at": 1.5 },
  { "id": "02-hola", "speaker": "pino", "text": "¡Hola, amigos! Soy Pino.", "at": 11.2 },
  { "id": "02-dia", "speaker": "pino", "text": "¡Qué lindo día en el Bosque Redondo!", "pauseBefore": 0.6 },
  { "id": "03-tema", "speaker": "pino", "text": "Hoy vamos a aprender los colores.", "at": 18.8 },
  { "id": "03-tres", "speaker": "pino", "text": "Tres colores: rojo, azul y amarillo.", "pauseBefore": 0.7 },
  { "id": "04-vamos", "speaker": "pino", "text": "¿Me acompañan? ¡Vamos a buscar colores!", "at": 29 },
  { "id": "05-nube", "speaker": "nube", "text": "Hola, Pino… mira arriba… ¿ves la manzana?", "at": 36.8 },
  { "id": "05-pino", "speaker": "pino", "text": "¡Hola, Nube! ¡Sí, una manzana!", "pauseBefore": 0.4 },
  { "id": "06-nube", "speaker": "nube", "text": "La manzana es roja.", "at": 47 },
  { "id": "06-pino", "speaker": "pino", "text": "¡Rojo! La manzana es roja.", "pauseBefore": 0.6 },
  { "id": "07-pregunta", "speaker": "pino", "text": "¿Y ustedes? ¿De qué color es la manzana?", "at": 56.8 },
  { "id": "07-respuesta", "speaker": "pino", "text": "¡Rojo! ¡Muy bien!", "pauseBefore": 3 },
  { "id": "08-nube", "speaker": "nube", "text": "También son rojos… el hongo… y la frutilla.", "at": 68.4 },
  { "id": "08-pino", "speaker": "pino", "text": "Rojo, rojo, rojo. ¡Qué lindo color!", "pauseBefore": 0.4 },
  { "id": "09-beto", "speaker": "beto", "text": "¡Tirirí! ¡Hola, Pino! ¡Miren arriba! ¡El cielo!", "at": 79.4 },
  { "id": "09-pino", "speaker": "pino", "text": "¡Hola, Beto!", "pauseBefore": 0.4 },
  { "id": "10-pino", "speaker": "pino", "text": "El cielo es azul.", "at": 88.8 },
  { "id": "10-beto", "speaker": "beto", "text": "¡Azul! Azul como el cielo.", "pauseBefore": 0.5 },
  { "id": "11-pregunta", "speaker": "pino", "text": "¿Y ustedes? ¿De qué color es el cielo?", "at": 98.8 },
  { "id": "11-respuesta", "speaker": "pino", "text": "¡Azul! ¡Muy bien!", "pauseBefore": 3 },
  { "id": "12-beto", "speaker": "beto", "text": "La laguna es azul. ¡Y las flores!", "at": 110.8 },
  { "id": "12-pino", "speaker": "pino", "text": "Azul, azul, azul. ¡Qué lindo color!", "pauseBefore": 0.5 },
  { "id": "13-nube", "speaker": "nube", "text": "Y miren el sol, amigos…", "at": 121.5 },
  { "id": "13-pino", "speaker": "pino", "text": "¡Qué lindo sol!", "pauseBefore": 0.5 },
  { "id": "14-pino", "speaker": "pino", "text": "¡El sol es amarillo!", "at": 130.8 },
  { "id": "14-beto", "speaker": "beto", "text": "¡Amarillo, amarillo!", "pauseBefore": 0.4 },
  { "id": "15-pregunta", "speaker": "pino", "text": "¿Y ustedes? ¿De qué color es el sol?", "at": 140.8 },
  { "id": "15-respuesta", "speaker": "pino", "text": "¡Amarillo! ¡Muy bien!", "pauseBefore": 3 },
  { "id": "16-nube", "speaker": "nube", "text": "El girasol… y la mariposa… también son amarillos.", "at": 152.3 },
  { "id": "16-pino", "speaker": "pino", "text": "Amarillo, amarillo, amarillo. ¡Qué lindo color!", "pauseBefore": 0.3 },
  { "id": "17-pino", "speaker": "pino", "text": "Hoy aprendimos tres colores. ¿Se acuerdan?", "at": 163 },
  { "id": "18-manzana", "speaker": "pino", "text": "La manzana es…", "at": 172.8 },
  { "id": "18-roja", "speaker": "pino", "text": "¡roja!", "pauseBefore": 2 },
  { "id": "18-cielo", "speaker": "pino", "text": "El cielo es…", "pauseBefore": 0.9 },
