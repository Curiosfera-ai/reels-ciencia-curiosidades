  { "id": "18-amarillo", "speaker": "pino", "text": "¡amarillo!", "pauseBefore": 2 },
  { "id": "19-cantar", "speaker": "pino", "text": "Rojo, azul y amarillo. ¡Qué lindos colores! Y ahora… ¡a cantar!", "at": 190.6 },
  { "id": "23-chau", "speaker": "pino", "text": "¡Chau, amigos! Nos vemos en otra tarde del Bosque Redondo.", "at": 243 },
  { "id": "23-nube", "speaker": "nube", "text": "Chau…", "pauseBefore": 0.5 },
